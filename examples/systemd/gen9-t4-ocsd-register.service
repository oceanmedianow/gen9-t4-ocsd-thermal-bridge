[Unit]
Description=Check Gen9 T4 OCSD sensor registration after boot
After=nvidia-persistenced.service
Wants=gen9-t4-ocsd.service

[Service]
Type=oneshot
EnvironmentFile=/etc/gen9-t4-ocsd.conf
ExecStart=/usr/bin/python3 /opt/gen9-t4-ocsd/gen9_t4_ocsd_register.py
TimeoutStartSec=210
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
